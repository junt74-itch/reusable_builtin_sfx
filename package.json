{
  "name": "reusable-procedural-sfx-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "setup:emsdk": "bun scripts/setup-emsdk.ts",
    "build:wasm": "bun scripts/build-wasm.ts",
    "test:core": "bun scripts/test-core.ts",
    "test": "bun run build:wasm && bun run test:core && bun test tests",
    "typecheck": "tsc --noEmit",
    "dev": "bun run build:wasm && vite",
    "build": "bun run build:wasm && vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "check": "bun run test && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
