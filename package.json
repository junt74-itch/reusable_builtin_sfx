{
  "name": "reusable-procedural-sfx-wasm",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "setup:emsdk": "bun scripts/setup-emsdk.ts",
    "build:wasm": "bun scripts/build-wasm.ts",
    "test:core": "bun scripts/test-core.ts",
    "test": "bun run test:core && bun test tests",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "dev:phaser": "vite --config vite.phaser.config.ts",
    "dev:authoring": "vite --config vite.authoring.config.ts",
    "build:authoring": "vite build --config vite.authoring.config.ts",
    "preview:authoring": "vite preview --config vite.authoring.config.ts",
    "sfx": "bun scripts/sfx-cli.ts",
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "prepack": "bun run build:wasm && bun run build",
    "check": "bun run test && bun run typecheck && bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "phaser": "4.2.1",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
